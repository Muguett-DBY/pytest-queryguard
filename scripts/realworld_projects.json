{
  "_comment": [
    "Projects for .github/workflows/realworld.yml, each pinned to a release tag.",
    "The tags and the install commands were written from public information and",
    "have not been run yet: re-check each tag (and that its install and test",
    "commands still match the project's own CI) before the first run.",
    "Fields: name (matrix key, used by the 'projects' input), repository, ref",
    "(tag or commit SHA), python, workdir (relative to the project checkout),",
    "install (bash, runs in workdir with the run's virtual environment active;",
    "uv sync installs into it through UV_PROJECT_ENVIRONMENT), pytest_args",
    "(split on spaces), prepare (bash, runs in workdir before each of the two",
    "runs, empty: nothing), postgres (start PostgreSQL on localhost:5432 with",
    "the env below), env (exported for every later step)."
  ],
  "projects": [
    {
      "name": "sqlmodel",
      "repository": "fastapi/sqlmodel",
      "ref": "0.0.24",
      "python": "3.12",
      "workdir": ".",
      "install": "uv pip install -e . -r requirements-tests.txt",
      "prepare": "",
      "pytest_args": "tests",
      "postgres": false,
      "env": {}
    },
    {
      "name": "full-stack-fastapi-template",
      "repository": "fastapi/full-stack-fastapi-template",
      "ref": "0.8.0",
      "python": "3.12",
      "workdir": "backend",
      "install": "uv sync --frozen",
      "prepare": "docker exec realworld-postgres psql -U postgres -d postgres -c 'DROP DATABASE IF EXISTS app WITH (FORCE)' -c 'CREATE DATABASE app' && python app/backend_pre_start.py && alembic upgrade head && python app/initial_data.py",
      "pytest_args": "app/tests",
      "postgres": true,
      "env": {
        "POSTGRES_SERVER": "localhost",
        "POSTGRES_PORT": "5432",
        "POSTGRES_USER": "postgres",
        "POSTGRES_PASSWORD": "changethis",
        "POSTGRES_DB": "app"
      }
    },
    {
      "name": "mlflow-sqlalchemy-store",
      "repository": "mlflow/mlflow",
      "ref": "v2.22.0",
      "python": "3.11",
      "workdir": ".",
      "install": "uv pip install -e . -r requirements/test-requirements.txt",
      "prepare": "",
      "pytest_args": "tests/store/tracking/test_sqlalchemy_store.py",
      "postgres": false,
      "env": {}
    },
    {
      "name": "sqladmin",
      "repository": "aminalaee/sqladmin",
      "ref": "0.20.1",
      "python": "3.12",
      "workdir": ".",
      "install": "python -I -c \"import tomllib; print('\\n'.join(tomllib.load(open('pyproject.toml', 'rb'))['tool']['hatch']['envs']['test']['dependencies']))\" > \"$RUNNER_TEMP/test-requirements.txt\" && uv pip install -e '.[full]' -r \"$RUNNER_TEMP/test-requirements.txt\"",
      "prepare": "",
      "pytest_args": "tests",
      "postgres": false,
      "env": {}
    },
    {
      "name": "advanced-alchemy",
      "repository": "litestar-org/advanced-alchemy",
      "ref": "v1.4.4",
      "python": "3.12",
      "workdir": ".",
      "install": "uv sync --frozen --all-extras --all-groups",
      "prepare": "",
      "pytest_args": "tests/unit",
      "postgres": false,
      "env": {}
    },
    {
      "name": "fastapi-users-db-sqlalchemy",
      "repository": "fastapi-users/fastapi-users-db-sqlalchemy",
      "ref": "v7.0.0",
      "python": "3.12",
      "workdir": ".",
      "install": "python -I -c \"import tomllib; print('\\n'.join(tomllib.load(open('pyproject.toml', 'rb'))['tool']['hatch']['envs']['default']['dependencies']))\" > \"$RUNNER_TEMP/test-requirements.txt\" && uv pip install -e . -r \"$RUNNER_TEMP/test-requirements.txt\"",
      "prepare": "",
      "pytest_args": "tests",
      "postgres": false,
      "env": {}
    }
  ]
}
